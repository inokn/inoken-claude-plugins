{
  "name": "inoken-ai/php-upgrade-tools",
  "description": "php-upgrade スキルが使う点検ツール一式（run.sh setup がプラグインの外にコピーして入れる）",
  "require": {
    "squizlabs/php_codesniffer": "^3.13.3 || ^4.0",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
